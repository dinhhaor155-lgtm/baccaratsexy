LOGIN_URL=https://example.com
USERNAME=your_username
PASSWORD=your_password

# Optional: set these only if auto-detect cannot click the right controls.
USERNAME_SELECTOR=
PASSWORD_SELECTOR=
LOGIN_BUTTON_SELECTOR=
SEXY_SELECTOR=
SEXY_TEXT=Sexy

# Keep HEADLESS=false for first setup so you can see captcha/extra checks if any.
HEADLESS=false
POLL_MS=5000
USER_DATA_DIR=.browser-profile
